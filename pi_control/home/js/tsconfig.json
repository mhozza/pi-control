{
    "compilerOptions": {
        "noImplicitAny": true,
        "module": "es2020",
        "target": "es2020",
        "jsx": "react",
        "allowJs": true,
        "moduleResolution": "node",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "incremental": true
    },
    "exclude": [
        "node_modules",
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        "setupTests.ts"
    ]
}
